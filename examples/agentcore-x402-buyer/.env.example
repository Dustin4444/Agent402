# Copy to .env and fill in the values the `agents-pay` skill printed when it
# provisioned your payment resources (see README). Then: `set -a; . ./.env; set +a`

AWS_PROFILE=agent402
AWS_REGION=us-west-2

# From the agents-pay / agents-build skill output:
PAYMENT_MANAGER_ARN=arn:aws:bedrock-agentcore:us-west-2:ACCOUNT_ID:payment-manager/pm-XXXXXXXX
PAYMENT_INSTRUMENT_ID=pi-XXXXXXXX
PAYMENT_SESSION_ID=ps-XXXXXXXX
PAYMENT_USER_ID=agent402-demo-user

# What to buy. Default is a $0.001 deterministic Agent402 tool (POST /api/hash).
# TESTNET first: set TARGET_URL=https://sandbox.node4all.com/v1/x402-test with a
# Base-Sepolia-funded wallet to validate for free. For a REAL Agent402 buy the
# wallet needs USDC on Base MAINNET.
TARGET_URL=https://agent402.tools/api/hash
TARGET_METHOD=POST
TARGET_BODY={"text":"hello world","algo":"sha256"}
