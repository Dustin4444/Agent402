{
  "about": "Tier 2 (env-gated on WARPCAST_API_KEY / NEYNAR_API_KEY): the nine Farcaster tools. Outside the corpus until 2026-09-13 because the runner counted an unlisted kit as UNKNOWN and failed the run - fixed the same day, which is what makes these addable. Neynar is quota-metered rather than per-call billed, so a pass here is cheap. Every shape below was read from a live call before it was asserted.",
  "cases": [
    {
      "slug": "fc-trending",
      "name": "trending channels come back populated",
      "requires": "WARPCAST_API_KEY",
      "input": {
        "limit": 3
      },
      "expect": {
        "gte": {
          "count": 1
        },
        "isArray": [
          "channels"
        ],
        "populated": [
          "channels.0.id",
          "channels.0.name"
        ],
        "gt": {
          "channels.0.followerCount": 0
        }
      }
    },
    {
      "slug": "fc-user-search",
      "name": "a known handle resolves with its fid",
      "requires": "WARPCAST_API_KEY",
      "input": {
        "q": "vitalik",
        "limit": 2
      },
      "expect": {
        "gte": {
          "count": 1
        },
        "populated": [
          "users.0.username",
          "users.0.fid"
        ],
        "gt": {
          "users.0.followerCount": 1000
        }
      }
    },
    {
      "slug": "fc-channel",
      "name": "a channel by id carries its follower count",
      "requires": "WARPCAST_API_KEY",
      "input": {
        "channel": "farcaster"
      },
      "expect": {
        "equals": {
          "channel.id": "farcaster"
        },
        "populated": [
          "channel.name"
        ],
        "gt": {
          "channel.followerCount": 1000
        }
      }
    },
    {
      "slug": "fc-channel-feed",
      "name": "a channel feed returns casts with authors",
      "requires": "WARPCAST_API_KEY",
      "input": {
        "channel": "farcaster",
        "limit": 2
      },
      "expect": {
        "gte": {
          "count": 1
        },
        "populated": [
          "casts.0.hash",
          "casts.0.author.username"
        ]
      }
    },
    {
      "slug": "fc-cast-search",
      "name": "a literal search returns matching casts",
      "requires": "WARPCAST_API_KEY",
      "input": {
        "q": "x402",
        "limit": 2
      },
      "expect": {
        "equals": {
          "query": "x402"
        },
        "gte": {
          "count": 1
        },
        "populated": [
          "casts.0.hash",
          "casts.0.text"
        ]
      }
    },
    {
      "slug": "fc-user-casts",
      "name": "a user's own casts, by fid",
      "requires": "WARPCAST_API_KEY",
      "input": {
        "fid": 5650,
        "limit": 2
      },
      "expect": {
        "equals": {
          "fid": 5650
        },
        "gte": {
          "count": 1
        },
        "populated": [
          "casts.0.hash"
        ]
      }
    },
    {
      "slug": "fc-cast",
      "name": "a real cast hash resolves to its author and text",
      "requires": "WARPCAST_API_KEY",
      "input": {
        "identifier": "0x322c451ed6ff1674328c6164b92166b3d15f2b7d"
      },
      "expect": {
        "equals": {
          "cast.hash": "0x322c451ed6ff1674328c6164b92166b3d15f2b7d",
          "cast.author.username": "dwr"
        },
        "populated": [
          "cast.text"
        ]
      }
    },
    {
      "slug": "fc-cast",
      "name": "a hash that is on no cast is refused by name, not answered empty",
      "requires": "WARPCAST_API_KEY",
      "input": {
        "identifier": "0x0000000000000000000000000000000000000001"
      },
      "expect": {
        "status": 404,
        "matches": {
          "error": "not found"
        }
      }
    },
    {
      "slug": "fc-cast-replies",
      "name": "replies carry the parent cast",
      "requires": "WARPCAST_API_KEY",
      "input": {
        "identifier": "0x322c451ed6ff1674328c6164b92166b3d15f2b7d",
        "limit": 2
      },
      "expect": {
        "equals": {
          "cast.hash": "0x322c451ed6ff1674328c6164b92166b3d15f2b7d"
        },
        "populated": [
          "cast.author.username"
        ]
      }
    },
    {
      "slug": "fc-cast-metrics",
      "name": "a term with real volume returns non-empty buckets",
      "requires": "WARPCAST_API_KEY",
      "input": {
        "q": "x402",
        "interval": "7d"
      },
      "expect": {
        "equals": {
          "query": "x402",
          "interval": "7d"
        },
        "gt": {
          "total": 0,
          "bucketCount": 0
        },
        "isArray": [
          "buckets"
        ]
      }
    },
    {
      "slug": "fc-cast-metrics",
      "name": "a blank query is refused before any upstream call",
      "requires": "WARPCAST_API_KEY",
      "input": {
        "q": ""
      },
      "expect": {
        "status": 400,
        "matches": {
          "error": "q"
        }
      }
    }
  ]
}